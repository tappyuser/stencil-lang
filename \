static string_t* read_file(string_t* sourcefile){
	#define BUFLEN 1024
	char _buffer[BUFLEN];
	FILE* fileptr = fopen(sourcefile->content, "r");
	fread(_buffer, sizeof(char), BUFLEN, fileptr);
	fclose(fileptr);

	return string_create(_buffer, 0);
}

